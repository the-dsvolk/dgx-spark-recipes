# dual-spark cluster config — the ONE place site-specific hostnames/IPs live.
#
# Copy to `cluster.env` and edit for your two boxes:
#     cp cluster.env.example cluster.env
# `cluster.env` is git-ignored (real hostnames/IPs stay out of the repo).
# Both launch-dual-spark.sh and the README commands read these values.

# --- nodes (SSH names; head is rank 0, worker is rank 1) ---
HEAD_HOST=spark-a.local
WORKER_HOST=spark-b.local
SSH_USER=nvidia

# --- RoCE addressing ---------------------------------------------------------
# One physical QSFP port on GB10 exposes TWO PCIe rails (two netdevs). Give each
# rail an IP on each node. rail0 = port p0 / PCIe domain 0000, rail1 = domain 0002.
HEAD_RAIL0_IP=192.168.100.1
WORKER_RAIL0_IP=192.168.100.2
HEAD_RAIL1_IP=192.168.101.1
WORKER_RAIL1_IP=192.168.101.2
# NCCL rendezvous master (must equal HEAD_RAIL0_IP) + torch.distributed port.
MASTER_IP=192.168.100.1
MASTER_PORT=29500

# --- serving -----------------------------------------------------------------
SERVE_PORT=8000

# --- RoCE / NCCL device knobs (usually the same on every DGX Spark) ----------
IB_HCA=rocep1s0f0,roceP2p1s0f0          # both RoCE HCAs -> multi-rail
IB_GID_INDEX=3                           # RoCEv2 IPv4 GID
IB_IFACES=enp1s0f0np0,enP2p1s0f0np0      # netdevs for NCCL/GLOO bootstrap
GLOO_IF=enp1s0f0np0
UVERBS="uverbs0 uverbs1 uverbs2 uverbs3"   # /dev/infiniband/* verbs devices to map in

# --- images ------------------------------------------------------------------
BASE_IMAGE=vllm/vllm-openai:cu130-nightly
IMAGE=vllm-spark-nccl:cu130              # NCCL-fixed image built by `launch-dual-spark.sh build`
